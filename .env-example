FLASK_ENV=development
FLASK_SECRET_KEY=change-me-please

# Comma-separated CTI providers. Start with mock for local development.
# Available: mock, otx
ENABLED_CTI_PROVIDERS=mock

# SQLite path. Defaults to instance/sentinel_scan.sqlite3 when unset.
SENTINEL_DB_PATH=instance/sentinel_scan.sqlite3

OTX_API_KEY=your_otx_api_key_here
OTX_RATE_LIMIT=10
